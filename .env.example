# Copia este archivo como .env y protégelo: chmod 600 .env  (.env no se sube a git)

# prueba = solo avisa de lo que haría, sin fichar. real = ficha de verdad.
MODO=prueba

# Usuario y contraseña de Sesame (panel antiguo, panel.sesametime.com)
SESAME_EMAIL=tu@empresa.com
SESAME_PASSWORD=

# Bot de Telegram (créalo con @BotFather) y tu chat (envía un mensaje al bot y mira
# https://api.telegram.org/bot<TOKEN>/getUpdates → message.chat.id)
TELEGRAM_TOKEN=
TELEGRAM_CHAT=

# Opcional: "Dirección secreta en formato iCal" de un calendario de Google (termina en /basic.ics)
GOOGLE_ICAL_URL=
